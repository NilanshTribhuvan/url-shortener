# Where short links are served from (the backend's APP_BASE_URL).
# Only needed when the list endpoint is used: it doesn't return shortUrl.
# Defaults: http://localhost:8080 in dev, the page origin in production.
# VITE_SHORT_BASE_URL=http://localhost:8080

# Dev proxy target for /api (vite.config.ts)
# VITE_BACKEND_URL=http://localhost:8080
